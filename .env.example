PORT=3000
DATABASE_HOST=localhost
PORT_DB=5432
DATABASE_NAME=postgres
USERNAME_DB=postgres
DATABASE_PASSWORD=postgres
DATABASE_SYNCHRONIZE=false
DATABASE_DROP_SCHEMA=false
DATABASE_LOGGING=false
JWT_SECRET=change-me-in-local-env
UPLOAD_DIR=/uploads
MAX_IMAGE_MB=5
APP_NAME=Mi Ecommerce
EMAIL_VERIFICATION_URL_BASE=http://localhost:5173/verify-email?token=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-app-password
EMAIL_FROM=Mi App <your-email@example.com>

# Frontend base URL (used for invitation emails)
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated list of allowed origins (no trailing slash)
# Production example: ALLOWED_ORIGINS=https://merku.co,https://www.merku.co
ALLOWED_ORIGINS=http://localhost:5173

# SSL para bases de datos en la nube (Aiven, Railway, etc.)
DB_SSL=false

# Push notifications (VAPID — genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@merku.co

# Sentry — monitoreo de errores en producción (https://sentry.io)
# Dejar vacío para desactivar
SENTRY_DSN=

# Cloudflare Turnstile — verificación CAPTCHA en login/registro
# En dev: dejar vacío (la verificación se omite automáticamente)
# En producción: obtén el Secret Key desde Cloudflare → Turnstile → tu widget
TURNSTILE_SECRET_KEY=

# Cloudinary (https://cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
